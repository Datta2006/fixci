# --- GitHub App ---
GITHUB_APP_ID=123456
# Path to the GitHub App private key PEM (mounted read-only in compose).
GITHUB_PRIVATE_KEY_PATH=private-key.pem
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-string

# --- LLM ---
# Option 1: Anthropic (Claude) directly
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Option 2: OpenRouter (supports many models including Claude, GPT, Llama, etc.)
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Pipeline ---
MAX_ATTEMPTS=3
SANDBOX_TIMEOUT=180
DATABASE_URL=sqlite:///fixci.db

# Set to false to skip Docker verification (diagnosis-only mode).
SANDBOX_ENABLED=true
