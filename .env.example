# --- GitHub App ---
GITHUB_APP_ID=123456
# Path to the GitHub App private key PEM (mounted read-only in compose).
GITHUB_PRIVATE_KEY_PATH=private-key.pem
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-string

# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Pipeline ---
MAX_ATTEMPTS=3
SANDBOX_TIMEOUT=180
DATABASE_URL=sqlite:///fixci.db

# Set to false to skip Docker verification (diagnosis-only mode).
SANDBOX_ENABLED=true
